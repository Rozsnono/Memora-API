# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/memora?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Synology NAS Storage API (WebDAV Uploader)
UPLOAD_API_URL=https://api.filesharer.rozsnorbert.hu:9443
NEXT_PUBLIC_UPLOAD_API_URL=https://api.filesharer.rozsnorbert.hu:9443
UPLOAD_API_KEY=test-secret-key-12345

# Pusher Realtime Configuration
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Agora Video Call
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
